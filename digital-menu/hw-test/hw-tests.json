    {
      "id": "P-1",
      "title": "보드 앱 APK 빌드",
      "risks": [
        "B-7"
      ],
      "where": "dev",
      "minutes": 10,
      "steps": [
        {
          "n": "1",
          "do": "개발 PC의 Git Bash에서 digital-menu/board-app/build.sh 를 실행합니다.",
          "expect": "마지막에 '완료: …/build/menuboard-player.apk' 가 나오고 오류가 없음"
        },
        {
          "n": "2",
          "do": "만든 APK 파일과 버전을 기록합니다.",
          "expect": "build/menuboard-player.apk 와 build/updates/board-app.json 이 있고 버전 코드가 맞음",
          "auto": "build.apk"
        },
        {
          "n": "3",
          "do": "apksigner verify --print-certs build/menuboard-player.apk 로 인증서 SHA-256 지문을 적습니다. 출고용이면 백업한 출시용 키의 지문과 비교합니다.",
          "expect": "출고용 APK는 출시용 키 지문과 같음(디버그 키면 '기록만')"
        }
      ]
    },
    {
      "id": "P-2",
      "title": "TV 보드에 앱 설치",
      "risks": [
        "B-14"
      ],
      "where": "any",
      "minutes": 10,
      "steps": [
        {
          "n": "1",
          "do": "TV 보드를 USB(또는 adb 네트워크)로 이 PC에 연결하고 board-app/install-board-app.bat 을 실행합니다.",
          "expect": "'Success' 가 나오고 'Failure'·'Exception' 이 없음. 마지막에 TV에 메뉴판 또는 설정 화면이 뜸",
          "shot": "pos"
        },
        {
          "n": "2",
          "do": "TV 화면을 봅니다.",
          "expect": "1분 안에 메뉴판이 뜨거나(서버 자동 찾기 성공), 설정 화면이 뜸. 검은 화면·앱 꺼짐 없음"
        }
      ]
    },
    {
      "id": "P-3",
      "title": "POS기 TV 관리 화면에서 TV 확인",
      "risks": [
        "R-1"
      ],
      "where": "pos",
      "needs": [
        "server",
        "login"
      ],
      "minutes": 5,
      "steps": [
        {
          "n": "1",
          "do": "POS기 브라우저로 http://127.0.0.1:8090/devices.html 을 엽니다.",
          "expect": "새 TV가 목록에 보이고 '켜짐'",
          "auto": "tv.list"
        },
        {
          "n": "2",
          "do": "지금 TV 화면을 가져옵니다.",
          "expect": "40초 안에 TV 화면 사진이 저장됨, 사진이 실제 TV와 같음",
          "auto": "tv.shot"
        }
      ]
    },
    {
      "id": "P-4",
      "title": "A/S 연결(adb)로 TV 상태 읽기",
      "risks": [
        "R-1",
        "B-8"
      ],
      "where": "pos",
      "needs": [
        "server",
        "login",
        "adb"
      ],
      "minutes": 5,
      "steps": [
        {
          "n": "1",
          "do": "A/S 연결을 30분 열고 adb로 붙습니다(A/S 관리자 계정이 필요할 수 있음).",
          "expect": "adb 연결됨",
          "auto": "tv.openAdb",
          "args": {
            "minutes": 30
          }
        },
        {
          "n": "2",
          "do": "보드 정보(모델·안드로이드·해상도·ro.adb.secure·저장공간·온도)를 기록합니다.",
          "expect": "RK3568, 안드로이드 11 이상, /data 빈 공간 1GB 이상",
          "auto": "adb.info"
        },
        {
          "n": "3",
          "do": "앱 버전과 권한을 기록합니다.",
          "expect": "WRITE_SECURE_SETTINGS 허용, 다른 앱 위에 표시 허용",
          "auto": "adb.app"
        },
        {
          "n": "4",
          "do": "홈 앱과 맨 앞 화면을 봅니다.",
          "expect": "홈 앱이 com.menuboard.player (안 되면 부팅 수신기로 뜨는지 H-3에서 확인), 맨 앞이 메뉴판",
          "auto": "adb.home"
        },
        {
          "n": "5",
          "do": "앱이 꺼진 기록을 찾습니다.",
          "expect": "com.menuboard.player 꺼짐(FATAL) 기록 없음",
          "auto": "adb.crash"
        }
      ]
    },
    {
      "id": "H-25",
      "title": "설치 묶음 실기기(install-server.bat)",
      "risks": [
        "B-2",
        "B-5",
        "B-20",
        "B-21",
        "M-18"
      ],
      "where": "pos",
      "needs": [
        "admin",
        "server"
      ],
      "minutes": 40,
      "steps": [
        {
          "n": "①",
          "do": "C:\\MenuBoard\\server\\install-server.bat 을 더블클릭 → UAC 예. 끝까지 진행합니다.",
          "expect": "한글 깨짐·빨간 오류 없음, '[주의]' 0개",
          "shot": "pos",
          "value": {
            "label": "[주의] 개수",
            "max": 0
          }
        },
        {
          "n": "①-a",
          "do": "설치가 만든 설정을 자동으로 확인합니다.",
          "expect": "작업 MenuBoardServer 가 SYSTEM으로 실행 중",
          "auto": "server.task"
        },
        {
          "n": "①-b",
          "do": "",
          "expect": "방화벽 8090 허용(같은 공유기 안만), pocketbase.exe 차단 규칙 없음",
          "auto": "win.firewall"
        },
        {
          "n": "①-c",
          "do": "",
          "expect": "전원 연결 시 절전·최대 절전 안 함, 빠른 시작 꺼짐",
          "auto": "win.power"
        },
        {
          "n": "⑦",
          "do": "",
          "expect": "업데이트 사용 시간 7~24시, 로그인 중 자동 재시작 안 함",
          "auto": "win.updateHours"
        },
        {
          "n": "①-d",
          "do": "",
          "expect": "Defender 검사 예외에 서버 폴더",
          "auto": "win.defender"
        },
        {
          "n": "①-e",
          "do": "",
          "expect": "서버가 127.0.0.1과 LAN 주소 모두에서 응답",
          "auto": "server.lan"
        },
        {
          "n": "②",
          "do": "POS기를 다시 시작하고 로그인하지 않은 채 1분 기다린 뒤, 폰으로 http://POS기주소:8090/?screen=1 을 엽니다. 그다음 로그인하면 이 시험이 이어집니다.",
          "expect": "로그인 없이 1분 안에 다른 기기에서 메뉴판이 열림",
          "reboot": true
        },
        {
          "n": "②-a",
          "do": "다시 켠 뒤 서버가 뜬 시간을 계산합니다.",
          "expect": "Windows가 켜지고 120초 안에 서버가 시작됨",
          "auto": "win.bootToServer",
          "args": {
            "max": 120
          }
        },
        {
          "n": "③",
          "do": "서버(pocketbase.exe)를 강제로 끄고 다시 뜨는지 잽니다. 영업 중이 아닐 때만.",
          "expect": "15초 안에 다시 응답",
          "auto": "server.killRecover",
          "args": {
            "max": 15
          }
        },
        {
          "n": "④",
          "do": "작업 스케줄러를 열어 기본 화면(작업 스케줄러 라이브러리)에 MenuBoardServer 가 보이는지 봅니다.",
          "expect": "보임, 상태 '실행 중'",
          "shot": "pos"
        },
        {
          "n": "⑤",
          "do": "start-server.bat 을 관리자 권한으로 켜 봅니다. 창을 닫은 뒤 'schtasks /end /tn MenuBoardServer' 를 실행하고 작업 관리자에 pocketbase.exe 가 남는지 봅니다. 끝나면 'schtasks /run /tn MenuBoardServer'.",
          "expect": "start-server.bat 창이 켜짐, schtasks /end 뒤 pocketbase.exe가 남으면 실패로 적고 메모"
        },
        {
          "n": "⑤-a",
          "do": "",
          "expect": "start-server.bat 창이 남아 있지 않고 서버 다시 응답",
          "auto": "server.health"
        },
        {
          "n": "⑥",
          "do": "uninstall-server.bat → install-server.bat 을 두 번 반복합니다.",
          "expect": "매번 오류 없음, 메뉴 데이터 그대로"
        },
        {
          "n": "⑥-a",
          "do": "",
          "expect": "다시 설치 뒤 작업·서버 정상",
          "auto": "server.task"
        },
        {
          "n": "⑧",
          "do": "표준(관리자 아님) Windows 계정으로 로그인해 http://127.0.0.1:8090/admin.html 을 엽니다.",
          "expect": "수정 화면이 열림"
        }
      ]
    },
    {
      "id": "H-27",
      "title": "일반 계정이 서버 파일을 못 건드리는지",
      "risks": [
        "B-19"
      ],
      "where": "pos",
      "needs": [
        "admin"
      ],
      "minutes": 15,
      "steps": [
        {
          "n": "1",
          "do": "서버 폴더 권한을 읽습니다.",
          "expect": "Users(일반 사용자)는 읽기·실행만",
          "auto": "win.folderAcl"
        },
        {
          "n": "2",
          "do": "관리자가 아닌 Windows 계정으로 로그인해 C:\\MenuBoard\\server\\pb_data\\data.db 를 바탕 화면에 복사해 봅니다.",
          "expect": "거부됨"
        },
        {
          "n": "3",
          "do": "같은 계정으로 run-server.ps1 을 메모장으로 고쳐 저장해 봅니다.",
          "expect": "저장 거부됨"
        },
        {
          "n": "4",
          "do": "같은 계정으로 server 폴더 이름을 바꿔 봅니다.",
          "expect": "거부됨"
        }
      ]
    },
    {
      "id": "H-26",
      "title": "다른 사이트·손님 폰에서 초기화·관리 화면이 막히는지",
      "risks": [
        "B-18",
        "M-10",
        "H-8"
      ],
      "where": "pos",
      "needs": [
        "server"
      ],
      "minutes": 15,
      "steps": [
        {
          "n": "1",
          "do": "손님 와이파이(또는 같은 공유기)의 폰에서 http://POS기주소:8090/_/ 를 엽니다.",
          "expect": "열리지 않거나 403"
        },
        {
          "n": "2",
          "do": "같은 폰에서 http://POS기주소:8090/reset.html 을 엽니다.",
          "expect": "POS기 밖에서는 막힘"
        },
        {
          "n": "3",
          "do": "POS기 Chrome·Edge로 아무 인터넷 사이트를 연 상태에서 개발팀이 준 시험 페이지(다른 사이트에서 local-reset 보내기)를 엽니다. 시험 페이지가 없으면 건너뜁니다.",
          "expect": "403, 데이터 그대로"
        },
        {
          "n": "4",
          "do": "POS기에서 reset.html 로 비밀번호를 바꾼 뒤 사장님 폰의 수정 화면을 새로 고칩니다.",
          "expect": "폰이 로그아웃됨"
        }
      ]
    },
    {
      "id": "H-12",
      "title": "백신(V3·알약)과 함께",
      "risks": [
        "M-22"
      ],
      "where": "pos",
      "needs": [
        "server"
      ],
      "minutes": 30,
      "steps": [
        {
          "n": "1",
          "do": "설치된 백신 목록을 기록합니다.",
          "expect": "기록만",
          "auto": "win.antivirus"
        },
        {
          "n": "2",
          "do": "V3 Lite(또는 알약)를 설치하고 실시간 검사를 켠 채 install-server.bat 을 다시 실행합니다.",
          "expect": "설치 막힘·격리 없음"
        },
        {
          "n": "3",
          "do": "POS기를 다시 시작합니다. 로그인하면 이어집니다.",
          "expect": "",
          "reboot": true
        },
        {
          "n": "3-a",
          "do": "",
          "expect": "다시 켠 뒤 서버가 응답",
          "auto": "server.health"
        },
        {
          "n": "4",
          "do": "백신 격리함·차단 기록에 pocketbase.exe, run-server.ps1, 번호 처리 앱이 있는지 봅니다.",
          "expect": "없음",
          "shot": "pos"
        }
      ]
    },
    {
      "id": "S-1",
      "title": "판매 프로그램과 함께 돌 때 POS기 부하",
      "risks": [
        "B-1"
      ],
      "where": "pos",
      "needs": [
        "server"
      ],
      "minutes": 20,
      "steps": [
        {
          "n": "1",
          "do": "판매 프로그램을 켜고 평소처럼 주문 몇 건을 넣습니다. 그동안 부하를 5분 동안 잽니다.",
          "expect": "전체 CPU 평균 70% 아래, 남은 메모리 1GB 이상, pocketbase 메모리 300MB 아래",
          "auto": "pos.resources",
          "args": {
            "seconds": 300
          }
        },
        {
          "n": "2",
          "do": "판매 프로그램 화면을 메뉴판 관련 창이 가리지 않는지 봅니다(번호 처리 앱이 있으면 항상 위 창 위치).",
          "expect": "결제 버튼·금액이 가려지지 않음",
          "shot": "pos"
        }
      ]
    },
    {
      "id": "H-13",
      "title": "TV 설정 화면 저장",
      "risks": [
        "B-14"
      ],
      "where": "pos",
      "needs": [
        "server",
        "login"
      ],
      "minutes": 15,
      "steps": [
        {
          "n": "1",
          "do": "리모컨 확인 버튼을 2초 눌러 설정 화면을 엽니다.",
          "expect": "설정 화면이 뜸, 서버 주소·화면 번호·글자 배율·방향·밝기 칸이 보임",
          "shot": "tv"
        },
        {
          "n": "2",
          "do": "화면 번호를 2로, 글자 배율을 120으로 바꾸고 '저장하고 메뉴판 보기'를 누릅니다. 누른 뒤 Enter.",
          "expect": "앱이 꺼지지 않고 메뉴판으로 돌아옴(안드로이드 홈 화면이 보이면 실패)"
        },
        {
          "n": "2-a",
          "do": "",
          "expect": "꺼짐 기록 없음(adb가 붙어 있을 때)",
          "auto": "adb.crash"
        },
        {
          "n": "2-b",
          "do": "",
          "expect": "TV가 보고한 값이 화면 2, 배율 120",
          "auto": "tv.reported",
          "args": {
            "screen": 2,
            "zoom": 120
          }
        },
        {
          "n": "3",
          "do": "TV 보드 전원을 뽑았다 꽂습니다. 꽂은 순간 Enter.",
          "expect": "3분 안에 다시 켜져 보고함",
          "auto": "tv.waitOnline",
          "args": {
            "max": 180
          }
        },
        {
          "n": "3-a",
          "do": "",
          "expect": "다시 켠 뒤에도 화면 2, 배율 120 그대로",
          "auto": "tv.reported",
          "args": {
            "screen": 2,
            "zoom": 120
          }
        },
        {
          "n": "4",
          "do": "설정 화면에서 원래 값(화면 1, 배율 100)으로 돌려놓습니다.",
          "expect": "돌아옴"
        }
      ]
    },
    {
      "id": "H-3",
      "title": "부팅 자동 실행",
      "risks": [
        "R-3"
      ],
      "where": "pos",
      "needs": [
        "server",
        "login"
      ],
      "minutes": 15,
      "steps": [
